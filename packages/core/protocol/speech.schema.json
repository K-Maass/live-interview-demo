{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpeechEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meetingId",
    "segmentId",
    "revision",
    "journalSequence",
    "lane",
    "startMs",
    "endMs",
    "language",
    "text",
    "kind"
  ],
  "properties": {
    "meetingId": {
      "type": "string"
    },
    "segmentId": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "sourceSegmentId": {
      "type": "string"
    },
    "speakerClusterId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "journalSequence": {
      "type": "integer",
      "minimum": 0
    },
    "startMs": {
      "type": "integer",
      "minimum": 0
    },
    "endMs": {
      "type": "integer",
      "minimum": 0
    },
    "lane": {
      "enum": [
        "me",
        "remote"
      ]
    },
    "kind": {
      "enum": [
        "partial",
        "final",
        "translation"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
